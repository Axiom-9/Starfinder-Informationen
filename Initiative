 function empty(){return {fighters:[],seq:0,round:1,started:false,active:null,target:null,skipDead:true};}
 var s=empty(),type='player',saveAvailable=true,toaster=null;
 try{var raw=window.localStorage.getItem(KEY);if(raw){var parsed=JSON.parse(raw);if(parsed&&Array.isArray(parsed.fighters)){
   s.fighters=parsed.fighters.filter(function(f){return f && typeof f.id==='string' && typeof f.name==='string' && number(f.ini,-999,999)!==null;}).map(function(f,i){var max=number(f.max,1,99999);return {id:f.id,name:f.name.slice(0,60),kind:f.kind==='enemy'?'enemy':'player',ini:f.ini,seq:number(f.seq,0,1000000)===null?i:f.seq,max:f.kind==='enemy'?max:null,hp:f.kind==='enemy'&&max!==null?clamp(number(f.hp,0,99999)===null?max:f.hp,0,max):null};});
   s.seq=Math.max(0,s.fighters.reduce(function(m,f){return Math.max(m,f.seq);},0)+1);s.round=number(parsed.round,1,9999)||1;s.started=!!parsed.started;s.active=typeof parsed.active==='string'?parsed.active:null;s.target=typeof parsed.target==='string'?parsed.target:null;s.skipDead=parsed.skipDead!==false;
 }}}
 catch(err){saveAvailable=false;}
 function find(id){for(var i=0;i<s.fighters.length;i++){if(s.fighters[i].id===id)return s.fighters[i];}return null;}
 function sorted(){return s.fighters.slice().sort(function(a,b){return b.ini-a.ini||a.seq-b.seq;});}
 function able(f){return f && (!s.skipDead||f.kind!=='enemy'||f.hp===null||f.hp>0);}
 function turnList(){return sorted().filter(able);}
 function makeId(){return 'f'+Date.now().toString(36)+Math.random().toString(36).slice(2,9);}
 function save(){try{window.localStorage.setItem(KEY,JSON.stringify(s));el('storage-note').textContent='Änderungen werden auf diesem Gerät gespeichert.';saveAvailable=true;}catch(err){el('storage-note').textContent='Speichern nicht verfügbar – diese Sitzung bleibt nutzbar.';saveAvailable=false;}}
