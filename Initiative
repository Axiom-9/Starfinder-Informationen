<script>
(function(){
 'use strict';
 var KEY='starfinder-ipad-tracker-2026-tested-v2';
 function el(id){return document.getElementById(id);}
 function show(id,on){el(id).classList.toggle('hide',!on);}
 function number(v,min,max){var n=Number(v);return v!=='' && isFinite(n) && Math.floor(n)===n && n>=min && n<=max?n:null;}
