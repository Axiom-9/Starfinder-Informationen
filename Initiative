  <div class="grid">
    <aside class="sidebar">
      <section class="panel"><div class="panel-head"><h2><span class="index">01</span>Kämpfer hinzufügen</h2></div><div class="panel-body">
        <form id="add-form" autocomplete="off">
          <div class="typebar" role="group" aria-label="Kämpfertyp"><button type="button" id="type-player" class="kind selected" aria-pressed="true">Spieler</button><button type="button" id="type-enemy" class="kind" aria-pressed="false">Gegner</button></div>
          <label class="field"><span class="label">Name</span><input class="input" id="new-name" required maxlength="60" placeholder="z. B. Pirat" autocomplete="off"></label>
          <div class="fieldline"><label class="field"><span class="label">Initiative</span><input class="input" id="new-ini" type="number" required step="1" min="-999" max="999" placeholder="Wert" inputmode="numeric"></label><label class="field"><span class="label">Anzahl</span><input class="input" id="new-count" type="number" min="1" max="20" step="1" value="1" required inputmode="numeric"></label></div>
          <label id="hp-add-wrap" class="field hide"><span class="label">Maximale Gegner-TP</span><input class="input" id="new-hp" type="number" min="1" max="99999" step="1" value="20" inputmode="numeric"></label>
          <button type="submit" class="btn primary wide" id="add-button">+ Kämpfer hinzufügen</button>
        </form>
        <div class="note">Bei Anzahl &gt; 1 werden die Kämpfer automatisch nummeriert.</div>
      </div></section>
      <section class="panel"><div class="panel-head"><h2><span class="index">02</span>Gegner · Trefferpunkte</h2></div><div class="panel-body">
        <div id="no-target" class="help">Wähle in der Kampfliste bei einem Gegner „TP“, um Schaden oder Heilung einzutragen.</div>
        <div id="target-controls" class="hide"><div class="hpname" id="target-name">–</div>
          <div class="hpfields"><label class="field"><span class="label">Aktuelle TP</span><input class="input" type="number" id="hp-now" min="0" step="1" inputmode="numeric"></label><label class="field"><span class="label">Maximale TP</span><input class="input" type="number" id="hp-max" min="1" step="1" inputmode="numeric"></label></div>
          <label class="field"><span class="label">Schaden / Heilung (Wert)</span><input class="input" type="number" id="hp-amount" min="1" max="99999" step="1" value="5" inputmode="numeric"></label>
          <div class="hpactions"><button class="btn warn" id="damage" type="button">− Schaden</button><button class="btn good" id="heal" type="button">+ Heilung</button></div>
