 function selectType(v){type=v;el('type-player').classList.toggle('selected',v==='player');el('type-enemy').classList.toggle('selected',v==='enemy');el('type-enemy').classList.toggle('enemy',v==='enemy');el('type-player').setAttribute('aria-pressed',String(v==='player'));el('type-enemy').setAttribute('aria-pressed',String(v==='enemy'));show('hp-add-wrap',v==='enemy');}
 function checkState(){if(!find(s.target)||find(s.target).kind!=='enemy'){s.target=null;for(var i=0;i<s.fighters.length;i++){if(s.fighters[i].kind==='enemy'){s.target=s.fighters[i].id;break;}}}if(s.started&&!find(s.active)){var avail=turnList();s.active=avail.length?avail[0].id:null;if(!avail.length)s.started=false;}}
 function render(){checkState();var order=sorted(),avail=turnList(),cur=find(s.active),sel=find(s.target);
  el('round').textContent='RUNDE '+('0'+s.round).slice(-2);el('total').textContent=order.length+' gesamt';el('players').textContent=order.filter(function(f){return f.kind==='player';}).length+' Spieler';el('enemies').textContent=order.filter(function(f){return f.kind==='enemy';}).length+' Gegner';
  el('current').textContent=s.started&&cur?cur.name:'Noch kein Kampf gestartet';el('current-detail').textContent=s.started&&cur?(cur.kind==='enemy'?'Gegner':'Spieler')+' · Initiative '+cur.ini+' · Platz '+(order.indexOf(cur)+1)+' von '+order.length:(order.length?'Bereit: Höchste Initiative beginnt.':'Füge links die Kämpfer hinzu.');
  el('next').textContent=s.started?'▶ Nächster Zug':'▶ Kampf starten';el('next').disabled=avail.length===0;el('back').disabled=!s.started||(s.round===1&&avail.length&&avail[0].id===s.active);el('new-round').disabled=order.length===0;el('clear').disabled=order.length===0;el('skip-defeated').textContent='0-TP-Gegner '+(s.skipDead?'überspringen ✓':'mitziehen ✕');
  show('no-target',!sel);show('target-controls',!!sel);
  if(sel){el('target-name').textContent=sel.name;el('hp-now').value=sel.hp===null?'':sel.hp;el('hp-max').value=sel.max===null?'':sel.max;el('hp-now').disabled=sel.max===null;el('damage').disabled=sel.max===null||sel.hp===0;el('heal').disabled=sel.max===null||sel.hp===sel.max;}
  var roster=el('roster'),scroll=roster.scrollTop;while(roster.firstChild)roster.removeChild(roster.firstChild);
  if(order.length===0){var blank=document.createElement('div');blank.className='empty';blank.innerHTML='<span class="empty-icon">⌖</span><b>Keine Kämpfer eingetragen</b><span>Links Namen und Initiative eingeben.</span>';roster.appendChild(blank);return;}
  order.forEach(function(f,i){var row=document.createElement('div');row.className='fighter'+(s.started&&f.id===s.active?' active':'')+(f.kind==='enemy'&&f.hp===0?' defeated':'');row.dataset.id=f.id;
   var rank=document.createElement('div');rank.className='rank';rank.textContent=String(i+1).padStart(2,'0');
   var ident=document.createElement('div');ident.className='identity';var name=document.createElement('input');name.className='name-input';name.type='text';name.maxLength=60;name.value=f.name;name.setAttribute('aria-label','Name ändern: '+f.name);name.addEventListener('change',function(){if(name.value.trim())f.name=name.value.trim();sync();});name.addEventListener('keydown',function(e){if(e.key==='Enter')name.blur();});var tag=document.createElement('div');tag.className='subtitle'+(f.kind==='enemy'?' enemy':'');tag.textContent=f.kind==='enemy'?(f.hp===0?'● GEGNER · 0 TP':'● GEGNER'):'● SPIELER';ident.appendChild(name);ident.appendChild(tag);
   var inic=document.createElement('div');inic.className='initcell';var iniLabel=document.createElement('span');iniLabel.className='ini-label';iniLabel.textContent='INI';var ini=document.createElement('input');ini.className='ini-input';ini.type='number';ini.min='-999';ini.max='999';ini.value=f.ini;ini.setAttribute('aria-label','Initiative ändern: '+f.name);ini.addEventListener('change',function(){var n=number(ini.value,-999,999);if(n!==null)f.ini=n;sync();});ini.addEventListener('keydown',function(e){if(e.key==='Enter')ini.blur();});inic.appendChild(iniLabel);inic.appendChild(ini);
   var hp=document.createElement('div');hp.className='hpbox';if(f.kind==='enemy'){
    var label=document.createElement('div');label.className='hptop';var lt=document.createElement('span');lt.textContent='TREFFERPUNKTE';var rt=document.createElement('strong');rt.textContent=f.max===null?'– / –':f.hp+' / '+f.max;label.appendChild(lt);label.appendChild(rt);var bar=document.createElement('div');bar.className='bar';var pct=f.max?100*f.hp/f.max:0;if(pct<=25)bar.className+=' low';else if(pct<=50)bar.className+=' mid';var fill=document.createElement('span');fill.style.width=pct+'%';bar.appendChild(fill);var minit=document.createElement('div');minit.className='hpmini';minit.appendChild(button('−1','tiny','1 Schaden: '+f.name,function(){changeHp(f.id,-1);},f.max===null));minit.appendChild(button('+1','tiny','1 Heilung: '+f.name,function(){changeHp(f.id,1);},f.max===null));minit.appendChild(button('TP','tiny pick'+(s.target===f.id?' picked':''),'Trefferpunkte auswählen: '+f.name,function(){s.target=f.id;sync();}));hp.appendChild(label);hp.appendChild(bar);hp.appendChild(minit);
   }else{var ph=document.createElement('div');ph.className='player-hint';ph.textContent='Spielercharakter';hp.appendChild(ph);}
   var ops=document.createElement('div');ops.className='rowops';ops.appendChild(button('▶','tiny','Jetzt an der Reihe: '+f.name,function(){s.started=true;s.active=f.id;sync();},!able(f)));ops.appendChild(button('↑','tiny','Gleichstand nach oben',function(){swap(f,order[i-1]);},i===0||order[i-1].ini!==f.ini));ops.appendChild(button('↓','tiny','Gleichstand nach unten',function(){swap(f,order[i+1]);},i===order.length-1||order[i+1].ini!==f.ini));ops.appendChild(button('×','tiny del','Kämpfer entfernen: '+f.name,function(){remove(f.id);},false));row.appendChild(rank);row.appendChild(ident);row.appendChild(inic);row.appendChild(hp);row.appendChild(ops);roster.appendChild(row);
  });roster.scrollTop=scroll;
 }
 function sync(){save();render();}
 function swap(a,b){if(!a||!b||a.ini!==b.ini)return;var x=a.seq;a.seq=b.seq;b.seq=x;sync();}
 function changeHp(id,delta){var f=find(id);if(!f||f.max===null)return;f.hp=clamp(f.hp+delta,0,f.max);s.target=f.id;sync();}
 function remove(id){var old=turnList(),idx=old.findIndex(function(f){return f.id===id;});s.fighters=s.fighters.filter(function(f){return f.id!==id;});if(s.active===id){var next=null;for(var i=idx+1;i<old.length;i++){if(find(old[i].id)&&able(find(old[i].id))){next=old[i];break;}}if(!next&&turnList().length){next=turnList()[0];s.round++;}s.active=next?next.id:null;if(!next)s.started=false;}if(s.target===id)s.target=null;if(!s.fighters.length)s=empty();sync();}
 function nextTurn(){var l=turnList();if(!l.length)return;if(!s.started){s.started=true;s.round=1;s.active=l[0].id;}else{var idx=l.findIndex(function(f){return f.id===s.active;});if(idx<0){s.active=l[0].id;}else{if(idx===l.length-1){s.round++;s.active=l[0].id;}else s.active=l[idx+1].id;}}sync();}
 function backTurn(){var l=turnList();if(!s.started||!l.length)return;var idx=l.findIndex(function(f){return f.id===s.active;});if(idx===0&&s.round===1)return;if(idx<=0){s.round=Math.max(1,s.round-1);s.active=l[l.length-1].id;}else s.active=l[idx-1].id;sync();}
 function newRound(){s.round=1;s.started=false;s.active=null;sync();notify('Kampf bereit – Initiative bleibt erhalten.');}
 el('type-player').addEventListener('click',function(){selectType('player');});el('type-enemy').addEventListener('click',function(){selectType('enemy');});
 el('add-form').addEventListener('submit',function(e){e.preventDefault();var name=el('new-name').value.trim(),ini=number(el('new-ini').value,-999,999),count=number(el('new-count').value,1,20),max=type==='enemy'?number(el('new-hp').value,1,99999):null;if(!name||ini===null||count===null||(type==='enemy'&&max===null)){notify('Bitte Name, Initiative und gegebenenfalls Gegner-TP eingeben.');return;}
  for(var i=1;i<=count;i++){var f={id:makeId(),name:count===1?name:name+' '+i,kind:type,ini:ini,seq:s.seq++,max:max,hp:max};s.fighters.push(f);if(type==='enemy'&&i===1)s.target=f.id;}el('new-name').value='';el('new-ini').value='';el('new-count').value='1';sync();notify(count+(count===1?' Kämpfer':' Kämpfer')+' hinzugefügt.');});
 el('next').addEventListener('click',nextTurn);el('back').addEventListener('click',backTurn);
 el('new-round').addEventListener('click',newRound);
 el('skip-defeated').addEventListener('click',function(){s.skipDead=!s.skipDead;sync();});
 el('clear').addEventListener('click',function(){if(window.confirm('Alle Kämpfer und TP wirklich löschen?')){s=empty();sync();notify('Kampfliste geleert.');}});
 el('hp-now').addEventListener('change',function(){var f=find(s.target);if(!f||f.max===null)return;var n=number(el('hp-now').value,0,99999);if(n!==null)f.hp=clamp(n,0,f.max);sync();});
 el('hp-max').addEventListener('change',function(){var f=find(s.target);if(!f)return;var n=number(el('hp-max').value,1,99999);if(n!==null){f.hp=f.max===null?n:clamp(f.hp,0,n);f.max=n;}sync();});
 function hpAdjust(sign){var f=find(s.target);if(!f||f.max===null)return;var amount=number(el('hp-amount').value,1,99999);if(amount===null){notify('Bitte gültigen Schadens- oder Heilungswert eingeben.');return;}changeHp(f.id,amount*sign);}
 el('damage').addEventListener('click',function(){hpAdjust(-1);});el('heal').addEventListener('click',function(){hpAdjust(1);});
 document.addEventListener('keydown',function(e){var t=e.target;if(t&&(/INPUT|TEXTAREA|SELECT/.test(t.tagName)||t.isContentEditable))return;if(e.key==='n'||e.key==='N'){e.preventDefault();nextTurn();}});
 selectType('player');el('js-warning').style.display='none';el('status').textContent='Interaktiv bereit';render();save();
})();
